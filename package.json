{
  "name": "@vroskus/library-sentry",
  "version": "1.0.31",
  "description": "Sentry",
  "author": "Vilius Roškus <vilius@regattas.eu>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vroskus/library-sentry.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run test:eslint && npm run test:type && npm run test:e2e",
    "test:eslint": "eslint src test --fix",
    "test:type": "tsc",
    "test:e2e": "echo 'No tests'"
  },
  "dependencies": {
    "@sentry/browser": "^10.52.0",
    "@sentry/node": "^10.52.0",
    "@sentry/profiling-node": "^10.52.0",
    "@types/express": "^5.0.6",
    "@vroskus/library-error": "^1.1.1",
    "lodash": "^4.18.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.2",
    "@vroskus/eslint-config": "^1.1.3",
    "jest": "^30.4.2",
    "jest-coverage-thresholds-bumper": "^1.1.0",
    "jest-express": "^1.12.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "coverageReporters": [
      "json-summary",
      "text"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0
      }
    }
  }
}
